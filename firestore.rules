rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny: only explicit rules below can grant access.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Firebase Admin SDK must set a trusted custom claim: { admin: true } or { role: "ADMIN" }.
    // Email verification and a non-null UID are not administrator privileges.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'ADMIN'
      );
    }

    function isValidCode(code) {
      return code is string && code.matches('^AO-[0-9]{6}$');
    }

    match /publicOrders/{code} {
      allow get: if isValidCode(code);
      allow list: if false;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
